---
import PostCard from '@/components/post/PostCard.astro';
import type { ProcessedPost, ResolvedCategory } from '@/lib/posts';

interface Props {
  category: ResolvedCategory;
  posts: ProcessedPost[];
  isFirstSection?: boolean;
}

const { category, posts, isFirstSection = false } = Astro.props;
---

<section aria-labelledby={`cat-heading-${category.slug}`} class="py-8 border-t border-zinc-200">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-blue-600" aria-hidden="true"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600">
          {category.slug}
        </span>
      </div>
      <h2
        id={`cat-heading-${category.slug}`}
        class="text-2xl sm:text-[1.65rem] font-extrabold text-zinc-900 tracking-tight"
      >
        {category.label}
      </h2>
      {
        category.description && (
          <p class="mt-1 text-sm text-zinc-600 max-w-2xl">{category.description}</p>
        )
      }
    </div>

    <a
      href={category.url}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-700 hover:text-blue-600 transition-colors shrink-0 group"
    >
      <span>전체 {category.count}개 글 보기</span>
      <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">→</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7">
    {
      posts.map((post, idx) => (
        <PostCard post={post} eagerLoad={isFirstSection && idx < 3} />
      ))
    }
  </div>
</section>
