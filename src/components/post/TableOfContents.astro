---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'mobile' | 'desktop';
}

const { headings, variant } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 && variant === 'mobile' && (
    <div class="xl:hidden mb-6">
      <details class="rounded-xl border border-zinc-200 bg-white px-4 py-3 shadow-sm">
        <summary class="cursor-pointer font-bold text-sm text-zinc-900 select-none">
          목차 (Table of Contents)
        </summary>
        <nav aria-label="모바일 본문 목차" class="mt-3 pt-2.5 border-t border-zinc-100">
          <ul class="space-y-2 text-sm">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'pl-4' : ''}>
                <a
                  href={`#${h.slug}`}
                  class="block text-zinc-600 hover:text-blue-600 transition-colors leading-snug"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  )
}

{
  tocHeadings.length > 0 && variant === 'desktop' && (
    <aside class="hidden xl:block w-64 shrink-0" aria-label="데스크톱 본문 목차">
      <div class="sticky top-24 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-zinc-400 mb-3">
          On This Page
        </h2>
        <nav id="desktop-toc-nav">
          <ul class="space-y-2 text-[13px] border-l border-zinc-200">
            {tocHeadings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class:list={[
                    'block py-0.5 -ml-px border-l-2 border-transparent text-zinc-500 hover:text-zinc-900 transition-colors leading-snug',
                    h.depth === 3 ? 'pl-6 text-xs' : 'pl-3.5 font-medium',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <script>
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
        if (tocLinks.length > 0) {
          const headingElements = Array.from(tocLinks)
            .map((link) => {
              const slug = link.getAttribute('data-toc-link');
              return slug ? document.getElementById(slug) : null;
            })
            .filter((el): el is HTMLElement => el !== null);

          const setActiveSlug = (activeSlug: string) => {
            tocLinks.forEach((link) => {
              const isMatch = link.getAttribute('data-toc-link') === activeSlug;
              link.classList.toggle('border-blue-600', isMatch);
              link.classList.toggle('text-blue-600', isMatch);
              link.classList.toggle('font-bold', isMatch);
              link.classList.toggle('border-transparent', !isMatch);
              link.classList.toggle('text-zinc-500', !isMatch);
            });
          };

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  setActiveSlug(entry.target.id);
                  break;
                }
              }
            },
            { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
          );

          headingElements.forEach((el) => observer.observe(el));
        }
      </script>
    </aside>
  )
}
