---
import type { ProcessedPost } from '@/lib/posts';

interface Props {
  prevPost: ProcessedPost | null;
  nextPost: ProcessedPost | null;
  categoryLabel: string;
  categoryUrl: string;
}

const { prevPost, nextPost, categoryLabel, categoryUrl } = Astro.props;
---

<nav aria-label="같은 카테고리 이전 및 다음 게시글" class="mt-14 pt-8 border-t border-zinc-200">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- 이전 글 (Older in same category) -->
    {
      prevPost ? (
        <a
          href={prevPost.url}
          class="group flex flex-col justify-between p-5 rounded-2xl border border-zinc-200 bg-white hover:border-blue-500 hover:shadow-sm transition-all"
        >
          <span class="text-xs font-semibold text-zinc-400 group-hover:text-blue-600 transition-colors">
            ← 이전 글 ({categoryLabel})
          </span>
          <span class="mt-2 font-bold text-base text-zinc-900 group-hover:text-blue-600 transition-colors line-clamp-2">
            {prevPost.title}
          </span>
          <span class="mt-2 text-xs text-zinc-400">{prevPost.formattedDate}</span>
        </a>
      ) : (
        <div class="flex flex-col justify-center p-5 rounded-2xl border border-zinc-200/60 bg-zinc-50/60 text-zinc-400">
          <span class="text-xs font-medium">← 이전 글</span>
          <span class="mt-1 text-sm">이 카테고리의 첫 번째 게시글입니다.</span>
        </div>
      )
    }

    <!-- 다음 글 (Newer in same category) -->
    {
      nextPost ? (
        <a
          href={nextPost.url}
          class="group flex flex-col justify-between p-5 rounded-2xl border border-zinc-200 bg-white hover:border-blue-500 hover:shadow-sm transition-all sm:text-right"
        >
          <span class="text-xs font-semibold text-zinc-400 group-hover:text-blue-600 transition-colors">
            다음 글 ({categoryLabel}) →
          </span>
          <span class="mt-2 font-bold text-base text-zinc-900 group-hover:text-blue-600 transition-colors line-clamp-2">
            {nextPost.title}
          </span>
          <span class="mt-2 text-xs text-zinc-400">{nextPost.formattedDate}</span>
        </a>
      ) : (
        <div class="flex flex-col justify-center p-5 rounded-2xl border border-zinc-200/60 bg-zinc-50/60 text-zinc-400 sm:text-right">
          <span class="text-xs font-medium">다음 글 →</span>
          <span class="mt-1 text-sm">이 카테고리의 가장 최신 게시글입니다.</span>
        </div>
      )
    }
  </div>

  <div class="mt-6 flex justify-center">
    <a
      href={categoryUrl}
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 hover:border-zinc-300 text-sm font-semibold text-zinc-700 transition-colors"
    >
      <span aria-hidden="true">☰</span>
      <span>{categoryLabel} 카테고리 목록으로 돌아가기</span>
    </a>
  </div>
</nav>
