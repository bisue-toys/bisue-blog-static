---
import Footer from '@/components/common/Footer.astro';
import Header from '@/components/common/Header.astro';
import SearchModal from '@/components/common/SearchModal.astro';
import { siteConfig } from '@/config/site';
import { withBase } from '@/lib/url';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeCategory?: string;
  ogImage?: string;
}

const {
  title,
  description = siteConfig.description,
  activeCategory,
  ogImage = withBase(siteConfig.defaultThumbnail),
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.title}` : `${siteConfig.title} — ${siteConfig.subtitle}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- OpenGraph Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />

    <!-- Pretendard Variable & JetBrains Mono Fonts -->
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FAFAFA] text-zinc-900 antialiased selection:bg-blue-600 selection:text-white">
    <Header activeCategory={activeCategory} currentPath={Astro.url.pathname} />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>

    <Footer />
    <SearchModal />
  </body>
</html>
