---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';
---

<BaseLayout title="페이지를 찾을 수 없습니다 (404)">
  <section class="py-24 text-center max-w-lg mx-auto">
    <p class="text-sm font-extrabold uppercase tracking-widest text-blue-600">Error 404</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight">
      요청하신 페이지를 찾을 수 없습니다
    </h1>
    <p class="mt-4 text-sm sm:text-base text-zinc-600 leading-relaxed">
      주소가 변경되었거나 삭제된 게시글일 수 있습니다. 상단 카테고리 메뉴나 검색 기능을 이용해 원하는 아티클을 찾아보세요.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a
        href={withBase('/')}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-blue-600 text-white text-sm font-bold transition-colors"
      >
        <span>웹진 홈으로 이동</span>
      </a>
      <a
        href={withBase('/posts/')}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-700 text-sm font-semibold transition-colors"
      >
        <span>전체 게시글 보기</span>
      </a>
    </div>
  </section>
</BaseLayout>
